[Unit]
Description=TFWatch monitoring and notification worker
Wants=network-online.target
After=network-online.target

[Service]
User=tfwatch
Group=tfwatch
WorkingDirectory=/opt/tfwatch/backend
EnvironmentFile=/etc/tfwatch.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
StateDirectory=tfwatch
StateDirectoryMode=0750
ExecStart=/opt/tfwatch/.venv/bin/python -m tfwatch.worker
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
