# Use an https:// origin in production. Set HOST_BIND=127.0.0.1 behind a reverse proxy.
PUBLIC_URL=http://localhost:8000
HOST_BIND=127.0.0.1
HOST_PORT=8000
DATABASE_URL=sqlite:////data/tfwatch.db
ENCRYPTION_KEY=
# Optional. If unset, Docker serves its build's source archive.
SOURCE_URL=
# Optional. TLS is required for mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
